# Copy to .env and fill in values

# MongoDB connection URI (same as the main backend)
MONGODB_URI=mongodb+srv://...

# 32-byte hex key for AES-256-GCM session encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=

# Optional: custom worker ID prefix (defaults to worker-<pid>)
# Each salon gets its own ID: <WORKER_ID>-<shopId>
WORKER_ID=supervisor

# Optional tuning
HEARTBEAT_INTERVAL_MS=30000
OUTBOX_POLL_INTERVAL_MS=2000
BROADCAST_SEND_INTERVAL_MS=800

# How often (ms) to poll DB for newly enabled/disabled salons
SALON_DISCOVERY_INTERVAL_MS=60000

# Optional: health check port
PORT=10001
